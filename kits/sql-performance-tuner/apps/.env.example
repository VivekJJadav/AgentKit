# Demo mode is the default and needs no credentials.
RUN_MODE="demo"

# Set to "true" only in a trusted deployment where live Lamatic calls are intended.
SQL_TUNER_ALLOW_LIVE=""

# Required only for live mode.
LAMATIC_API_URL=""
LAMATIC_PROJECT_ID=""
LAMATIC_API_KEY=""
SQL_TUNER_STRATEGIST_FLOW_ID=""
SQL_TUNER_REVIEWER_FLOW_ID=""
